{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "anthropic/claude-fable-5",
    "anthropic/claude-opus-4-6",
    "anthropic/claude-opus-4-8",
    "cpa/gpt-5.6-luna",
    "cpa/gpt-5.6-sol",
    "cpa/gpt-5.6-terra",
    "grok-cli/grok-4.6",
    "grok-cli/grok-composer-2.5-fast",
    "kiro/claude-opus-4-6-thinking",
    "kiro/claude-opus-4-7-thinking",
    "kiro/claude-opus-4-8-thinking",
    "kiro/claude-sonnet-4-6-thinking",
    "nahcrof/deepseek-v4-pro",
    "nahcrof/glm-5.2",
    "nahcrof/kimi-k2.6",
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "zai/glm-5.2",
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "opencode-go/deepseek-v4-pro",
    "nahcrof/deepseek-v4.1-flash",
    "opencode-go/deepseek-v4-flash",
    "anthropic/claude-opus-5",
    "cloudflare-workers-ai/@cf/zai-org/glm-5.2",
    "cloudflare-workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731",
    "cloudflare-workers-ai/@cf/deepseek-ai/deepseek-v4-pro-0813",
    "9router/cbcn/kimi-k3",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra",
    "cursor/cursor-grok-4.6-high-fast",
    "cursor/cursor-grok-4.6-medium-fast",
    "cursor/cursor-grok-4.6-xhigh-fast"
  ],
  "transport": "sse",
  "npmCommand": [
    "env",
    "NPM_CONFIG_MIN_RELEASE_AGE=0",
    "NPM_CONFIG_ALLOW_GIT=all",
    "NPM_CONFIG_IGNORE_SCRIPTS=false",
    "NPM_CONFIG_ENGINE_STRICT=false",
    "NPM_CONFIG_AUDIT=false",
    "npm"
  ],
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "packages": [
    {
      "source": "git:github.com/prateekmedia/pi-hooks",
      "extensions": [
        "-ralph-loop/ralph-loop.ts",
        "-lsp/lsp.ts",
        "-lsp/lsp-tool.ts"
      ]
    },
    "git:github.com/edxeth/pi-gpt-config",
    "git:github.com/edxeth/pi-tasks",
    "npm:@tomooshi/condensed-milk-pi",
    "git:github.com/edxeth/pi-better-skills",
    "git:github.com/edxeth/pi-subagents",
    "npm:pi-fancy-footer",
    "npm:@howaboua/pi-auto-trees",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@hsingjui/pi-hooks",
    "git:github.com/edxeth/pi-ralph-loop",
    "git:github.com/edxeth/pi-claude-auth",
    "../../Dev/AI/pi/extensions/pi-markdown-blocks",
    "../../Dev/AI/pi/extensions/pi-bash-backgrounder",
    "npm:@howaboua/pi-codex-conversion",
    "git:github.com/code-yeongyu/pi-ast-grep",
    "../../Dev/AI/pi/extensions/pi-linear",
    "../../Dev/AI/pi/extensions/pi-fold",
    "npm:pi-grok-cli",
    "npm:@eko24ive/pi-ask",
    "npm:@ian-pascoe/pi-lsp"
  ],
  "lastChangelogVersion": "0.85.1",
  "extensions": [
    "/Users/tothemoon/Dev/AI/pi/extensions/pi-ru",
    "/Users/tothemoon/Dev/AI/pi/extensions/pi-hub"
  ],
  "hideThinkingBlock": false,
  "theme": "tokyonight",
  "gptConfig": {
    "fastMode": false,
    "personality": "none",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": false,
    "toolDiscipline": "off"
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [
      {
        "id": "token-rate",
        "statusKey": "token-rate",
        "position": "right",
        "color": "accent"
      }
    ]
  },
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "tasksMode": "hidden",
  "permissionLevel": "high",
  "permissionMode": "ask",
  "permissionConfig": {
    "overrides": {
      "dangerous": [
        "rm *",
        "/bin/rm *",
        "/usr/bin/rm *",
        "*&& rm *",
        "*; rm *",
        "*|| rm *",
        "*| rm *",
        "rmdir *",
        "unlink *",
        "shred *",
        "truncate *",
        "*find * -delete*",
        "*git clean *",
        "*git reset --hard*",
        "*git restore *",
        "*git checkout -- *",
        "*git push *--force*",
        "*git push -f*",
        "*rsync *--delete*",
        "*docker system prune*",
        "*docker volume prune*",
        "*docker rm *",
        "*kubectl delete *",
        "*terraform destroy*",
        "*pulumi destroy*",
        "*chmod -R *",
        "*chown -R *",
        "wipefs *"
      ]
    }
  },
  "hooks": {},
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": false
  },
  "images": {
    "blockImages": false
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "tsgo",
        "args": [
          "--lsp",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          "tsconfig.json",
          "package.json"
        ],
        "requireRootMarker": true
      },
      "python": {
        "command": "basedpyright-langserver",
        "args": [
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".py",
              ".pyi"
            ],
            "languageId": "python"
          }
        ],
        "rootMarkers": [
          "pyproject.toml",
          "setup.py",
          ".git"
        ]
      },
      "rust": {
        "command": "rust-analyzer",
        "args": [],
        "languages": [
          {
            "extensions": [
              ".rs"
            ],
            "languageId": "rust"
          }
        ],
        "rootMarkers": [
          "Cargo.toml"
        ]
      },
      "oxlint": {
        "command": "bunx",
        "args": [
          "oxlint",
          "--lsp"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          },
          {
            "extensions": [
              ".js",
              ".mjs",
              ".cjs"
            ],
            "languageId": "javascript"
          },
          {
            "extensions": [
              ".jsx"
            ],
            "languageId": "javascriptreact"
          }
        ],
        "rootMarkers": [
          ".oxlintrc.json"
        ],
        "requireRootMarker": true
      },
      "oxfmt": {
        "command": "bunx",
        "args": [
          "oxfmt",
          "--lsp"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          },
          {
            "extensions": [
              ".js",
              ".mjs",
              ".cjs"
            ],
            "languageId": "javascript"
          },
          {
            "extensions": [
              ".jsx"
            ],
            "languageId": "javascriptreact"
          }
        ],
        "rootMarkers": [
          ".oxfmtrc.json"
        ],
        "requireRootMarker": true
      }
    },
    "timeouts": {
      "initializeMs": 45000,
      "requestMs": 3000,
      "diagnosticsMs": 3000
    }
  }
}