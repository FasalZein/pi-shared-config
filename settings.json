  "transport": "sse",
  "npmCommand": [
    "env",
    "NPM_CONFIG_MIN_RELEASE_AGE=0",
    "NPM_CONFIG_ALLOW_GIT=all",
    "NPM_CONFIG_IGNORE_SCRIPTS=false",
    "NPM_CONFIG_ENGINE_STRICT=false",
    "NPM_CONFIG_AUDIT=false",
    "npm"
  ],
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 6,
    "baseDelayMs": 1500
  },
  "packages": [
    "git:github.com/edxeth/pi-claude-auth@d99968e317b1132efdac7f1722380922af27af62",
    "git:github.com/edxeth/pi-subagents@37c375bf13e3ac0e034856a54a56e62e4ecc6f8a",
    "git:github.com/edxeth/pi-tasks@d4b07692427199d3db4f9f5e6441d9c82ee612d4",
    "npm:@howaboua/pi-codex-conversion@3.0.34",
    "git:github.com/edxeth/pi-better-skills@2deaf5c4b5e93ccd3c1b464c6a2dc3f24cd46205",
    "npm:@eko24ive/pi-ask@1.2.0",
    "npm:pi-fancy-footer@3.0.1",
    "git:github.com/edxeth/pi-ralph-loop@108823f8d1e2089fec1f7202ca3a8905d12df574",
    "npm:pi-grok-cli@0.8.2"
  ],
  "lastChangelogVersion": "0.85.1",
  "extensions": [],
  "hideThinkingBlock": false,
  "theme": "tokyonight",
  "gptConfig": {
    "fastMode": false,
    "personality": "none",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": false,
    "toolDiscipline": "off"
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [
      {
        "id": "token-rate",
        "statusKey": "token-rate",
        "position": "right",
        "color": "accent"
      }
    ]
  },
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "tasksMode": "hidden",
  "permissionLevel": "high",
  "permissionMode": "ask",
  "permissionConfig": {
    "overrides": {
      "dangerous": [
        "rm *",
        "/bin/rm *",
        "/usr/bin/rm *",
        "*&& rm *",
        "*; rm *",
        "*|| rm *",
        "*| rm *",
        "rmdir *",
        "unlink *",
        "shred *",
        "truncate *",
        "*find * -delete*",
        "*git clean *",
        "*git reset --hard*",
        "*git restore *",
        "*git checkout -- *",
        "*git push *--force*",
        "*git push -f*",
        "*rsync *--delete*",
        "*docker system prune*",
        "*docker volume prune*",
        "*docker rm *",
        "*kubectl delete *",
        "*terraform destroy*",
        "*pulumi destroy*",
        "*chmod -R *",
        "*chown -R *",
        "wipefs *"
      ]
    }
  },
  "hooks": {},
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": false
  },
  "images": {
    "blockImages": false
  }
