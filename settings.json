{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-4-6",
    "anthropic/claude-opus-4-8",
    "grok-cli/grok-4.7",
    "grok-cli/grok-4.7-build-fast",
    "grok-cli/grok-composer-2.5-fast",
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra"
  ],
  "transport": "sse",
  "npmCommand": [
    "env",
    "NPM_CONFIG_MIN_RELEASE_AGE=0",
    "NPM_CONFIG_ALLOW_GIT=all",
    "NPM_CONFIG_IGNORE_SCRIPTS=false",
    "NPM_CONFIG_ENGINE_STRICT=false",
    "NPM_CONFIG_AUDIT=false",
    "npm"
  ],
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 6,
    "baseDelayMs": 1500
  },
  "packages": [
    "git:github.com/edxeth/pi-claude-auth",
    "git:github.com/edxeth/pi-subagents",
    "git:github.com/edxeth/pi-tasks",
    "npm:@howaboua/pi-codex-conversion",
    "git:github.com/edxeth/pi-better-skills",
    "npm:@eko24ive/pi-ask",
    "npm:pi-fancy-footer",
    "git:github.com/edxeth/pi-ralph-loop",
    "npm:pi-grok-cli"
  ],
  "lastChangelogVersion": "0.87.1",
  "extensions": [],
  "hideThinkingBlock": false,
  "theme": "tokyonight",
  "gptConfig": {
    "fastMode": false,
    "personality": "none",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": false,
    "toolDiscipline": "off"
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [
      {
        "id": "token-rate",
        "statusKey": "token-rate",
        "position": "right",
        "color": "accent"
      }
    ]
  },
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "tasksMode": "hidden",
  "permissionLevel": "high",
  "permissionMode": "ask",
  "permissionConfig": {
    "overrides": {
      "dangerous": [
        "rm *",
        "/bin/rm *",
        "/usr/bin/rm *",
        "*&& rm *",
        "*; rm *",
        "*|| rm *",
        "*| rm *",
        "rmdir *",
        "unlink *",
        "shred *",
        "truncate *",
        "*find * -delete*",
        "*git clean *",
        "*git reset --hard*",
        "*git restore *",
        "*git checkout -- *",
        "*git push *--force*",
        "*git push -f*",
        "*rsync *--delete*",
        "*docker system prune*",
        "*docker volume prune*",
        "*docker rm *",
        "*kubectl delete *",
        "*terraform destroy*",
        "*pulumi destroy*",
        "*chmod -R *",
        "*chown -R *",
        "wipefs *"
      ]
    }
  },
  "hooks": {},
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": false
  },
  "images": {
    "blockImages": false
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "all"
}
