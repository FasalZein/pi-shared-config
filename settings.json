{
  "defaultThinkingLevel": "medium",
  "transport": "sse",
  "npmCommand": [
    "env",
    "NPM_CONFIG_MIN_RELEASE_AGE=0",
    "NPM_CONFIG_ALLOW_GIT=all",
    "NPM_CONFIG_IGNORE_SCRIPTS=false",
    "NPM_CONFIG_ENGINE_STRICT=false",
    "NPM_CONFIG_AUDIT=false",
    "npm"
  ],
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "packages": [
    {
      "source": "git:github.com/prateekmedia/pi-hooks",
      "extensions": [
        "-ralph-loop/ralph-loop.ts"
      ]
    },
    "git:github.com/edxeth/pi-gpt-config",
    "git:github.com/edxeth/pi-ptc-next",
    "git:github.com/edxeth/pi-tasks",
    "npm:@tomooshi/condensed-milk-pi",
    "git:github.com/edxeth/pi-better-skills",
    "git:github.com/eko24ive/pi-ask",
    "git:github.com/edxeth/pi-subagents",
    "npm:pi-fancy-footer",
    "npm:@howaboua/pi-auto-trees",
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "skills": [
        "-skills/ponytail/SKILL.md",
        "-skills/ponytail-audit/SKILL.md",
        "-skills/ponytail-debt/SKILL.md",
        "-skills/ponytail-gain/SKILL.md",
        "-skills/ponytail-help/SKILL.md"
      ]
    },
    "npm:@hsingjui/pi-hooks",
    "git:github.com/nicobailon/visual-explainer",
    "npm:pi-mcp-adapter",
    "git:github.com/edxeth/pi-ralph-loop",
    "git:github.com/edxeth/pi-claude-auth"
  ],
  "hideThinkingBlock": true,
  "theme": "tokyonight",
  "gptConfig": {
    "fastMode": false,
    "personality": "friendly",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": false,
    "toolDiscipline": "on"
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [
      {
        "id": "token-rate",
        "statusKey": "token-rate",
        "position": "right",
        "color": "accent"
      }
    ]
  },
  "quietStartup": true,
  "tasksMode": "open"
}
