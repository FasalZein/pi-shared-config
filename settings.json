  "enabledModels": [
    "anthropic/claude-opus-4-6",
    "anthropic/claude-opus-4-8",
    "cpa/gpt-6-sol",
    "cpa/gpt-6-luna",
    "cpa/gpt-5.6-luna",
    "cpa/gpt-5.6-sol",
    "cpa/gpt-5.6-terra",
    "grok-cli/grok-4.7",
    "grok-cli/grok-composer-2.5-fast",
    "kiro/claude-opus-4-6-thinking",
    "kiro/claude-opus-4-7-thinking",
    "kiro/claude-opus-4-8-thinking",
    "kiro/claude-sonnet-4-6-thinking",
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra",
    "cpa/claude-fable-5-1",
    "cpa/claude-opus-5-5"
  ],
  "transport": "sse",
  "npmCommand": [
    "env",
    "NPM_CONFIG_MIN_RELEASE_AGE=0",
    "NPM_CONFIG_ALLOW_GIT=all",
    "NPM_CONFIG_IGNORE_SCRIPTS=false",
    "NPM_CONFIG_ENGINE_STRICT=false",
    "NPM_CONFIG_AUDIT=false",
    "npm"
  ],
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 6,
    "baseDelayMs": 1500
  },
  "packages": [
    "git:github.com/edxeth/pi-claude-auth@d99968e317b1132efdac7f1722380922af27af62",
    "git:github.com/edxeth/pi-subagents@cf6dbf41c17986f3882e6804a68e8fb8282d25e6",
    "git:github.com/edxeth/pi-tasks@37143ee47610610db5b6cb86d94a7ffbb8ecf54d",
    "npm:@howaboua/pi-codex-conversion@3.0.39",
    "git:github.com/edxeth/pi-better-skills@447a0ca98e3131d50106736816d22fbca617a1f5",
    "npm:@eko24ive/pi-ask@1.2.0",
    "npm:pi-fancy-footer@3.0.2",
    "git:github.com/edxeth/pi-ralph-loop@108823f8d1e2089fec1f7202ca3a8905d12df574",
    "npm:pi-grok-cli@0.9.2"
  ],
  "lastChangelogVersion": "0.87.1",
  "extensions": [],
  "hideThinkingBlock": false,
  "theme": "tokyonight",
  "gptConfig": {
    "fastMode": false,
    "personality": "none",
    "verbosity": "low",
    "summary": "auto",
    "showFooter": false,
    "toolDiscipline": "off"
  },
  "powerline": {
    "preset": "default",
    "fixedEditor": false,
    "customItems": [
      {
        "id": "token-rate",
        "statusKey": "token-rate",
        "position": "right",
        "color": "accent"
      }
    ]
  },
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "tasksMode": "hidden",
  "permissionLevel": "high",
  "permissionMode": "ask",
  "permissionConfig": {
    "overrides": {
      "dangerous": [
        "rm *",
        "/bin/rm *",
        "/usr/bin/rm *",
        "*&& rm *",
        "*; rm *",
        "*|| rm *",
        "*| rm *",
        "rmdir *",
        "unlink *",
        "shred *",
        "truncate *",
        "*find * -delete*",
        "*git clean *",
        "*git reset --hard*",
        "*git restore *",
        "*git checkout -- *",
        "*git push *--force*",
        "*git push -f*",
        "*rsync *--delete*",
        "*docker system prune*",
        "*docker volume prune*",
        "*docker rm *",
        "*kubectl delete *",
        "*terraform destroy*",
        "*pulumi destroy*",
        "*chmod -R *",
        "*chown -R *",
        "wipefs *"
      ]
    }
  },
  "hooks": {},
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": false
  },
  "images": {
    "blockImages": false
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "all"
}
